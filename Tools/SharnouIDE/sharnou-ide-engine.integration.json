{
  "schema": "sharnou-ide-engine-integration/2",
  "project_id": "honour-war",
  "canonical": true,
  "ide": {"id": "Sharnou-IDE", "authority": "exclusive"},
  "engine": {"id": "SharnouEngine", "authority": "exclusive-runtime"},
  "protocol": "Sharnou Project Protocol (SPP)",
  "asset_policy": {
    "accepted_input_formats": "*",
    "conversion": "automatic",
    "runtime_representation": "SharnouEngine-native compiled asset package",
    "examples": [".gltf",".glb",".ktx2",".avif",".png",".jpg",".jpeg",".webp",".fbx",".obj",".tga",".dds",".bmp",".gif",".wav",".ogg",".mp3"]
