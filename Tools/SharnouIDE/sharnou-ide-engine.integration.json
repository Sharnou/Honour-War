    "automatic_downloads": false,
    "automatic_installation": false,
    "automatic_external_engine_selection": false,
    "automatic_external_ide_selection": false,
    "forbidden_runtime_engines": ["Unity","Unreal Engine","Godot","other external game engines"],
    "forbidden_authoring_ides": ["other IDEs"]
