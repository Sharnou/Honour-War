  "legacy_project_policy": {
    "automatic_conversion": true,
    "legacy_execution": false,
    "target": "Sharnou-IDE SPP"
  },
  "generation_policy": {
    "authoring_authority": "Sharnou-IDE",
    "runtime_authority": "SharnouEngine",
    "external_asset_generator_required": false,
    "daily_background_updates": false,
    "handoff": [
      "Sharnou-IDE identifies canonical honour-war project",
      "Sharnou-IDE converts authoring metadata to SPP",
      "SharnouEngine receives SPP and asset intake records",
      "SharnouEngine automatically converts and validates source assets",
      "SharnouEngine packages native runtime assets",
      "SharnouEngine runs Honour War"
    ]
  }
}