{
  "schema": "sharnou-ide-engine-integration/1",
  "project_id": "honour-war",
  "canonical": true,
  "ide": {
    "id": "Sharnou-IDE",
    "repository": "https://github.com/Sharnou/Sharnou-IDE",
    "authority": "exclusive"
  },
  "engine": {
    "id": "SharnouEngine",
    "repository": "https://github.com/Sharnou/Sharnou-Engine",
    "authority": "exclusive-runtime"
  },
  "protocol": "Sharnou Project Protocol (SPP)",
  "asset_policy": {
    "generated_raster_format": ".AVIF",
    "accepted_generated_raster_formats": [
      ".AVIF"
    ],
    "rejected_generated_raster_formats": [
      ".PNG",
      ".JPG",
      ".JPEG",
      ".WEBP",
      ".GIF",
      ".BMP",
      ".TGA",
      ".DDS"
    ]
  },
  "external_tool_policy": {
    "downloads": false,
    "bootstrap": false,
    "forbidden": [
      "Visual Studio",
      "MSBuild",
      "Windows SDK",
      "CMake",
      "vcpkg",
      "Unity",
      "Unreal Engine",
      "external programming tools"
    ]
  },
  "legacy_ide_policy": {
    "automatic_conversion": true,
    "target": "Sharnou-IDE SPP",
    "legacy_execution": false,
    "legacy_toolchain_execution": false
  },
  "generation_policy": {
    "authority": "SharnouEngine",
    "native_generation": true,
    "external_generation": false,
    "external_asset_generators_rejected": [
      "Neural4D",
      "Blender",
      "Substance 3D Painter",
      "Unity",
      "Unreal Engine",
      "Godot"
    ],
    "shipped_visual_format": ".AVIF",
    "automatic_handoff": {
      "order": [
        "Sharnou-IDE validates canonical project",
        "Sharnou-IDE compiles SPP",
        "SharnouEngine generates native Honour War runtime package",
        "SharnouEngine validates canonical data and generated package",
        "SharnouEngine launches Honour War runtime"
      ],
      "human_trigger": "explicit local IDE command only",
      "daily_background_updates": false
    }
  }
}
