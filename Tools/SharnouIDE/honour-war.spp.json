{
  "schema": "sharnou-project/3",
  "canonical_identity": {
    "project_id": "honour-war",
    "project_name": "Honour War",
    "repository": "https://github.com/Sharnou/Honour-War",
    "canonical": true
  },
  "project": {
    "id": "honour-war",
    "name": "Honour War",
    "genre": "3D HD MMORPG/ARPG"
  },
  "ide": {
    "id": "Sharnou-IDE",
    "repository": "https://github.com/Sharnou/Sharnou-IDE",
    "mode": "authoritative-and-exclusive"
  },
  "engine": {
    "id": "SharnouEngine",
    "name": "Sharnou Engine",
    "repository": "https://github.com/Sharnou/Sharnou-Engine",
    "source_root": "Engine/SharnouEngine",
    "runtime_candidates": [
      "Build/Runtime/SharnouEngine.exe",
      "Engine/SharnouEngine/bin/SharnouEngine.exe",
      "Tools/SharnouIDE/runtime/SharnouEngine.exe"
    ],
    "required_runtime_args": ["--self-test", "--runtime-test"]
  },
  "asset_format_policy": {
    "runtime_scene_containers": [".gltf", ".glb"],
    "runtime_scene_standard": "glTF 2.x",
    "runtime_3d_texture_format": ".ktx2",
    "runtime_3d_texture_standard": "KTX 2.0",
    "runtime_3d_texture_glTF_extension": "KHR_texture_basisu",
    "runtime_2d_raster_format": ".avif",
    "runtime_2d_uses": ["UI", "menu backgrounds", "icons", "skyboxes", "distribution images"],
    "authoring_interchange": [".fbx", ".obj"],
    "rejected_runtime_texture_formats": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".tga", ".dds"],
    "rejected_runtime_model_formats": [".fbx", ".obj", ".blend"],
    "legacy_conversion": "automatic metadata conversion; binary encoder is not downloaded"
  },
  "authoring": {
    "movement": "click-to-move",
    "command_examples": ["@go 0 230:220"],
    "content_pipeline": [
      "Visual RAG/reference analysis",
      "Neural4D or Blender processing",
      "FBX/OBJ intake",
      "Sharnou Engine asset import and validation",
      "runtime validation"
    ]
  },
  "ide_migration_policy": {
    "authoritative_ide": "Sharnou-IDE",
    "automatic_project_conversion": true,
    "supported_legacy_metadata": ["Visual Studio", "VS Code", "JetBrains", "Eclipse", "Xcode", "generic workspace metadata"],
    "convert_ide_project_metadata_to": "Sharnou-IDE SPP",
    "reject_non_sharnou_ide_runtime_control": true,
    "legacy_ide_execution": false,
    "legacy_toolchain_execution": false,
    "external_downloads": false
  },
  "forbidden_project_dependencies": [
    "Visual Studio",
    "MSBuild",
    "Windows SDK",
    "Unity",
    "Unreal Engine",
    "vcpkg",
    "CMake",
    "automatic external programming-tool downloads"
  ],
  "build_policy": {
    "mode": "Sharnou-IDE + SharnouEngine only",
    "network_downloads": false,
    "external_tool_bootstrap": false,
    "compiler_installation": "forbidden",
    "external_ide_authoring": false,
    "runtime_policy": "only an existing approved SharnouEngine runtime may be launched"
  }
}
