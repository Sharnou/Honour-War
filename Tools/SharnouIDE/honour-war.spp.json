{
  "schema": "sharnou-project/3",
  "canonical_identity": {
    "project_id": "honour-war",
    "project_name": "Honour War",
    "repository": "https://github.com/Sharnou/Honour-War",
    "canonical": true
  },
  "project": {
    "id": "honour-war",
    "name": "Honour War",
    "genre": "3D HD MMORPG/ARPG"
  },
  "ide": {
    "id": "Sharnou-IDE",
    "repository": "https://github.com/Sharnou/Sharnou-IDE",
    "mode": "authoritative-and-exclusive"
  },
  "engine": {
    "id": "SharnouEngine",
    "name": "Sharnou Engine",
    "repository": "https://github.com/Sharnou/Sharnou-Engine",
    "source_root": "Engine/SharnouEngine",
    "runtime_candidates": [
      "Build/Runtime/SharnouEngine.exe",
      "Engine/SharnouEngine/bin/SharnouEngine.exe",
      "Tools/SharnouIDE/runtime/SharnouEngine.exe"
    ],
    "required_runtime_args": [
      "--self-test",
      "--runtime-test"
    ]
  },
  "asset_format_policy": {
    "runtime_visual_format": ".avif",
    "runtime_visual_standard": "AV1 Image File Format",
    "runtime_visual_uses": [
      "UI",
      "HUD",
      "menu backgrounds",
      "icons",
      "portraits",
      "item art",
      "skill art",
      "skyboxes",
      "loading artwork",
      "distribution raster"
    ],
    "authoring_interchange": [
      ".fbx",
      ".obj"
    ],
    "geometry_runtime": "SharnouEngine-native compiled representation",
    "rejected_runtime_visual_formats": [
      ".gltf",
      ".glb",
      ".ktx2",
      ".png",
      ".jpg",
      ".jpeg",
      ".webp",
      ".gif",
      ".bmp",
      ".tga",
      ".dds"
    ],
    "legacy_conversion": "metadata-only migration; no binary runtime format conversion or external tool download"
  },
  "authoring": {
    "movement": "click-to-move",
    "command_examples": [
      "@go 0 230:220"
    ],
    "content_pipeline": [
      "Locked Screenshot reference inspection",
      "SharnouEngine native generation",
      "SharnouEngine native geometry/material/animation compilation",
      "AVIF visual delivery",
      "SharnouEngine runtime validation"
    ],
    "generation_authority": "SharnouEngine-only",
    "external_asset_generators": false,
    "external_art_generators": false
  },
  "ide_migration_policy": {
    "authoritative_ide": "Sharnou-IDE",
    "automatic_project_conversion": true,
    "supported_legacy_metadata": [
      "Visual Studio",
      "VS Code",
      "JetBrains",
      "Eclipse",
      "Xcode",
      "generic workspace metadata"
    ],
    "convert_ide_project_metadata_to": "Sharnou-IDE SPP",
    "reject_non_sharnou_ide_runtime_control": true,
    "legacy_ide_execution": false,
    "legacy_toolchain_execution": false,
    "external_downloads": false
  },
  "forbidden_project_dependencies": [
    "Visual Studio",
    "MSBuild",
    "Windows SDK",
    "Unity",
    "Unreal Engine",
    "vcpkg",
    "CMake",
    "automatic external programming-tool downloads"
  ],
  "build_policy": {
    "mode": "Sharnou-IDE + SharnouEngine only",
    "network_downloads": false,
    "external_tool_bootstrap": false,
    "compiler_installation": "forbidden",
    "external_ide_authoring": false,
    "runtime_policy": "only an existing approved SharnouEngine runtime may be launched"
  }
}
