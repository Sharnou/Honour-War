[application]
config/name="Honour War"
run/main_scene="res://Main3D.tscn"
; Honour War target engine: Godot 4.7.x; CI/export default: Godot 4.7.2 stable.
config/features=PackedStringArray("4.7")

[autoload]
GameplayFormula="*res://scripts/GameplayFormula.gd"
ChibiAnimePresentation="*res://scripts/ChibiAnimePresentation.gd"
HDProductionQualityDirector="*res://scripts/HDProductionQualityDirector.gd"
HWMouseAttack="*res://scripts/HWMouseAttack.gd"
ClassAdvancementRuntime="*res://scripts/ClassAdvancementRuntime.gd"
HWGeneratedAssetRuntime="*res://scripts/HWGeneratedAssetRuntime.gd"
OnlineAgeRuntime="*res://scripts/OnlineAgeRuntime.gd"
HonourWarRuntimeSanitizer="*res://scripts/HonourWarRuntimeSanitizer.gd"
HWWorldDetailDirector="*res://scripts/HWWorldDetailDirector.gd"
HWReadableActorDirector="*res://scripts/HWReadableActorDirector.gd"
HWWarpNetwork="*res://scripts/HWWarpNetwork.gd"
HWActorVitals="*res://scripts/HWActorVitals.gd"
HWMainInterface="*res://scripts/HWPolishedInterfaceV2.gd"
HWVisualMaxDirector="*res://scripts/HWVisualMaxDirectorFixed.gd"
HWCharacterEmotionDirector="*res://scripts/HWCharacterEmotionDirector.gd"
HWPrimitiveBeautyDirector="*res://scripts/HWPrimitiveBeautyDirector.gd"
HWVitalsStartupNormalizer="*res://scripts/HWVitalsStartupNormalizer.gd"
HWStartupDefaults="*res://scripts/HWStartupDefaults.gd"
HWSkillBarRuntime="*res://scripts/HWSkillBarRuntime.gd"
HWClassAutoAdvancement="*res://scripts/HWClassAutoAdvancement.gd"
GraphicsManager="*res://scripts/GraphicsManager.gd"
HWHDQualityRuntime="*res://scripts/HWHDQualityRuntime.gd"
HWFinalVisualDirector="*res://scripts/HWFinalVisualDirector.gd"
HWFinalQuickbar="*res://scripts/HWFinalQuickbar.gd"
HWPresentationGuard="*res://scripts/HWPresentationGuard.gd"
HWItemIconEnhancer="*res://scripts/HWItemIconEnhancer.gd"
HW3DInteractionDirector="*res://scripts/HW3DInteractionDirector.gd"
HWSSRentRuntime="*res://scripts/HWSSRentRuntime.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[display/window]
size/mode=0

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.driver="vulkan"
rendering/driver/driver_name="vulkan"
rendering/driver/fallback_to_angle=true
rendering/driver/fallback_to_native=true
rendering/rendering_device/fallback_to_opengl3=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false

[debug]

[debug/gdscript/warnings]
enable=true
inference_on_variant=0
inferred_declaration=0

[input]
move_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
camera_rotate_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":81)]}
camera_rotate_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
graphics_preset_low={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194324)]}
graphics_preset_med={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
graphics_preset_hd={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194326)]}
