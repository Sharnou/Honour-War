{
  "schema": "honour-war/sharnou-generation/2",
  "project_id": "honour-war",
  "engine": "SharnouEngine",
  "ide": "Sharnou-IDE",
  "generation_authority": "SharnouEngine-only",
  "external_generation": false,
  "active_generators": [
    "SharnouEngine"
  ],
  "rejected_active_generators": [
    "Neural4D",
    "Blender",
    "Substance 3D Painter",
    "Unity",
    "Unreal Engine",
    "Godot"
  ],
  "runtime_visual_format": ".avif",
  "rejected_runtime_visual_formats": [
    ".png",
    ".jpg",
    ".jpeg",
    ".webp",
    ".gif",
    ".bmp",
    ".tga",
    ".dds"
  ],
  "native_generation_domains": [
    "characters",
    "class progression",
    "skills",
    "monsters",
    "pets",
    "equipment",
    "items",
    "cards",
    "refinement",
    "maps",
    "terrain",
    "architecture",
    "props",
    "animation metadata",
    "combat VFX metadata",
    "HUD and UI layout",
    "save/progression state"
  ],
  "generation_rule": "SharnouEngine generates, compiles and runtime-validates Honour War from canonical repository data plus registered source assets; Sharnou-IDE performs universal intake, routing and SPP handoff.",
  "runtime_asset_strategy": {
    "scene_containers": [
      ".gltf",
      ".glb"
    ],
    "three_d_textures": [
      ".ktx2"
    ],
    "two_d_visuals": [
      ".avif"
    ],
    "glTF_texture_extension": "KHR_texture_basisu",
    "raster_visual_policy": ".AVIF only"
  },
  "source_asset_intake": "any-registered-format",
  "source_model_intake": [
    ".fbx",
    ".obj"
  ],
  "preserve_original_sources": true
}
