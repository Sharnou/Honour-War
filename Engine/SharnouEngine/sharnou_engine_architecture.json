{
  "schema": "sharnou-engine-architecture/2",
  "engine": "Sharnou Engine",
  "game": "Honour War",
  "authoring_controller": "Sharnou-IDE",
  "runtime": {
    "native": true,
    "platform": "Windows 64-bit",
    "graphics": "Direct3D 11",
    "target_style": "3D HD MMORPG/ARPG"
  },
  "core_subsystems": {
    "language": {
      "tokenizer": true,
      "custom_active_language": true,
      "SPP_operations": [
        "actor_spawn",
        "set_pos",
        "bind_mesh",
        "texture_avif",
        "texture_ktx2",
        "scene_gltf"
      ]
    },
    "ecs": {
      "entity_component_system": true,
      "dense_component_storage": true,
      "target_world_capacity": 300000
    },
    "tasks": {
      "asynchronous_worker_queue": true,
      "fixed_physics_step": true
    },
    "renderer": {
      "backend": "Direct3D 11",
      "depth_format": "D32_FLOAT",
      "shader_pipeline": "HLSL",
      "anisotropic_sampling": true
    },
    "gameplay": {
      "click_to_move": true,
      "camera_orbit_and_zoom": true,
      "monster_target_selection": true,
      "skill_slots": 8,
      "teleport_command": "@go MAP X:Y",
      "persistent_save": true,
      "network_identity": true
    }
  },
  "asset_policy": {
    "runtime_scene_containers": [".gltf", ".glb"],
    "runtime_scene_standard": "glTF 2.x",
    "runtime_3d_texture_format": ".ktx2",
    "runtime_3d_texture_standard": "KTX 2.0",
    "runtime_3d_texture_glTF_extension": "KHR_texture_basisu",
    "runtime_2d_raster_format": ".avif",
    "approved_authoring_interchange": [".fbx", ".obj"],
    "rejected_runtime_model_formats": [".fbx", ".obj", ".blend"],
    "rejected_runtime_texture_formats": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".dds", ".tga"]
  },
  "dependency_policy": {
    "external_programming_tool_downloads": false,
    "visual_studio": false,
    "msbuild": false,
    "windows_sdk_development_installation": false,
    "cmake": false,
    "vcpkg": false,
    "unity": false,
    "unreal_engine": false,
    "compiler_required": true,
    "compiler_source": "self-contained Sharnou toolchain"
  }
}